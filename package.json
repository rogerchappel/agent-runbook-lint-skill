{
  "name": "agent-runbook-lint-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first lint checks for agent automation runbooks.",
  "scripts": {
    "test": "\"$(bash scripts/python-for-npm.sh)\" -m pytest",
    "check": "\"$(bash scripts/python-for-npm.sh)\" -m compileall src tests",
    "smoke": "\"$(bash scripts/python-for-npm.sh)\" -m agent_runbook_lint check fixtures/good-runbook.md --report /tmp/agent-runbook-lint-report.md"
  }
}

